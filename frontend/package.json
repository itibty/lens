{
  "name": "lens",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "engines": {
    "node": ">= 20.12.1"
  },
  "scripts": {
    "dev": "vite --mode dev --open",
    "preview": "vite preview",
    "build": "run-p type-check build-only",
    "build-only": "vite build --mode prd",
    "build:analyze": "cross-env ANALYZE=true pnpm build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "generate-api": "node ./build/generate/openapi.config.cjs",
    "check-upgrade": "npm-check -u -i \"{sass,typescript,@visactor/*}\"",
    "preinstall": "npx only-allow pnpm"
  },
